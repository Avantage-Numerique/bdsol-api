{% extends 'default.njk' %}

{% block content %}

    <div class="indexContent">

        {% block contentHeader %}
            {% include "Partials/header.njk" %}
        {% endblock %}

        {% if item %}

            <h1>{{ title | safe }}</h1>

        {% endif %}

        <div class="breadcrumbs">
            <a class="btn" href="/ref" title="Référentiel">&larr; Référentiel</a>
        </div>

        {% if item %}

            <h2>{{ item.label }}</h2>

            <p>{{ item.description }}</p>

            <table>

                <thead>

                    <tr>
                        <th rowspan='2'>Nom dans l'ontologie</th>
                        <th rowspan='2'>Format</th>
                        <th rowspan='2'>Description</th>
                        <th colspan='2'>Compatibilité</th>
                        <th rowspan='2'>Note</th>
                    </tr>

                    <tr class="compat-header">
                        <th>Ontologie</th>
                        <th>Propriété</th>
                    </tr>
                </thead>

                <tbody>
                    {% for row in item.ref %}
                        <tr>
                            <td>{{ row.label }}
                                {% if row.ontologyProperty and row.ontologyProperty !== "" %}
                                    <br><code>{{ row.ontologyProperty }}</code>
                                {% endif %}
                            </td>

                            <td>
                                {% if row.ref %}
                                    <a href="/ref{{ row.url }}">
                                        {{ row.label }}
                                    </a>
                                {% elseif row.type === 'id' %}
                                    ID de :

                                    {% for entityRef in row.entityRef %}

                                        <a href="/ref/{{ entityRef }}">{{ entityRef }}</a>

                                    {% endfor %}

                                {% else %}

                                    {% if row.url %}
                                        <a href="/ref{{ row.url }}">{{ row.label }}</a> ({{ row.type }})
                                        
                                         {# <br><br> (<a href="/ref/{{ row.type }}">{{ row.type }}</a>) #}
                                    {% else %}
                                        {{ row.type }}
                                    {% endif %}

                                {% endif %}
                            </td>

                            <td>{{ row.description }}</td>

                            <td colspan="2">

                                <div class="compat-grid">

                                    {% for compatItem in row.compatibility %}

                                        <div>
                                            {{ compatItem.externalSource.name }}
                                        </div>

                                        <div>
                                            <a href="{{ compatItem.documentationUrl }}" target="_blank">
                                                {{ compatItem.mapping.externalField }}
                                            </a>
                                        </div>

                                    {% else %}

                                        <span class="nodata">Aucune donnée disponible.</span>

                                    {% endfor %}
                                </div>

                            </td>

                            <td>{{ row.note }}</td>

                        </tr>
                    {% endfor %}
                </tbody>

            </table>
        {% else %}
            <p>Rien à afficher!</p>
        {% endif %}

    </div>
{% endblock %}