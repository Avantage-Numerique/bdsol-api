{% extends 'default.njk' %}

{% block content %}

    <div class="indexContent">

        {% block contentHeader %}
            {% include "Partials/header.njk" %}
        {% endblock %}

        {% if item %}

            <h1>{{ title | safe }}</h1>

        {% else %}

            <h1>Référentiel de AVNU API</h1>

        {% endif %}

        <div class="breadcrumbs">
            <a class="btn" href="/ref" title="Référentiel">&larr; Référentiel</a>
        </div>

        {% if item %}

            <h2>{{ item.label }} <code>{{ item.ontologyProperty }}</code></h2>
            {% if item.compatibility.length > 0 %}
                <nav class="nav-compatibility small">
                    <ul>
                        <li><i class="la la-arrow-right"></i> Compatibilité <i class="la la-arrow-right"></i> ontologies <i class="la la-arrow-right"></i></li>
                        {% for compatItem in item.compatibility %}
                            <li>
                                <span>
                                    {{ compatItem.externalSource.name }}
                                </span>
                                <span>
                                    <a href="{{ compatItem.documentationUrl }}" target="_blank" class="btn external code">
                                        <i class="la la-link"></i>{{ compatItem.mapping.externalField }} <i class="la la-external-link"></i>
                                    </a>
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
            <p>{{ item.description }}</p>
            <table>

                <thead>

                    <tr>
                        <th rowspan='2'>Nom dans l'ontologie</th>
                        <th rowspan='2'>Format</th>
                        <th rowspan='2'>Description</th>
                        <th colspan='2'>Compatibilité</th>
                        <th rowspan='2'>Note</th>
                    </tr>

                    <tr class="compat-header">
                        <th>Ontologie</th>
                        <th>Propriété</th>
                    </tr>
                </thead>

                <tbody>
                    {% for row in item.ref %}
                        <tr>
                            <td>{{ row.label }}
                                {% if row.ontologyProperty and row.ontologyProperty !== "" %}
                                    <br>
                                        <code>{{ row.ontologyProperty }}</code>
                                    {% endif %}
                                </td>

                                <td>
                                    {% if row.type.kind === "object" %}
                                        <a href="{{ baseRoute }}{{ row.url }}">
                                            {{ row.label }}
                                        </a>
                                    {% elseif row.type.kind === 'reference' %}
                                        ID de :

                                        {% for entityRef in row.type.targets %}

                                            <a href="{{ baseRoute }}/{{ entityRef }}">{{ entityRef }}</a>

                                        {% endfor %}

                                    {% else %}

                                        {% if row.url %}
                                            <a href="{{ baseRoute }}{{ row.url }}">{{ row.label }}</a>
                                            ({{ row.type.name }})
                                        {% else %}
                                            {{ row.type.name }}
                                        {% endif %}

                                    {% endif %}
                                </td>

                                <td>{{ row.description }}</td>

                                <td colspan="2">

                                    <div class="compat-grid">

                                        {% for compatItem in row.compatibility %}

                                            <div>
                                                {{ compatItem.externalSource.name }}
                                            </div>

                                            <div>
                                                <a href="{{ compatItem.documentationUrl }}" target="_blank">
                                                    {{ compatItem.mapping.externalField }}
                                                </a>
                                            </div>

                                        {% else %}

                                            <span class="nodata">Aucune donnée de compatibilité disponible.</span>

                                        {% endfor %}
                                    </div>

                                </td>

                                <td>{{ row.note }}</td>

                            </tr>
                        {% endfor %}
                    </tbody>

                </table>
            {% else %}
                <p>Rien à afficher!</p>
            {% endif %}

        </div>
    {% endblock %}