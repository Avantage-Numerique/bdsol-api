<head>
    <meta charset="UTF-8"/>
    <title>{{ meta.title | safe }}</title>
    <meta name="description" content="{{ meta.description }}"/>
    <meta name="author" content="{{ meta.author }}"/>

    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet"/>

    <link rel="stylesheet" href="/styles/main.css" />

    <meta name="twitter:title" content="{{ defaultThumbnail.title }}" />
    <meta name="twitter:description" content="{{ defaultThumbnail.description }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="{{ defaultThumbnail.imageUrl }}" />
    <meta property="twitter:image:alt" content="{{ defaultThumbnail.imageAlt }}" />
    <meta property="twitter:image:width" content="{{ defaultThumbnail.imageWidth }}" />
    <meta property="twitter:image:height" content="{{ defaultThumbnail.imageHeight }}" />

    <meta name="og:title" content="{{ defaultThumbnail.title | safe }}" />
    <meta name="og:description" content="{{ defaultThumbnail.description | safe }}" />
    <meta property="og:locale" content="fr_CA" />
    {% if route.url %}<meta name="og:url" content="{{ api.baseUrl }}{{ route.url }}" />{% endif %}
    <meta name="og:image" content="{{ defaultThumbnail.imageUrl }}" />
    <meta property="og:image:alt" content="{{ defaultThumbnail.imageAlt }}" />
    <meta property="og:image:width" content="{{ defaultThumbnail.imageWidth }}" />
    <meta property="og:image:height" content="{{ defaultThumbnail.imageHeight }}" />

    <meta name="thumbnail" content="{{ defaultThumbnail.imageUrl }}" />

    <script type="application/ld+json">

    </script>

</head>