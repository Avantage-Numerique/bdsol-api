<!doctype html>
<html lang="fr">
{% include "Partials/head.njk" %}
<body>
<div class="mainContent">
    {% block content %}
        <div class="indexContent">
            {% block contentHeader %}
                {% include "Partials/header.njk" %}
            {% endblock %}
            <h1>{{ title }}</h1>
            <p>{{ body | safe }}</p>
            <ul>
                {% for status in statuses %}
                    <li>
                        <span>{{ status.label }}</span> : <span class="{% if status.value %}connected{% else %}disconnected{% endif %}">{{ status.valueLabel }}</span>
                    </li>
                {% else %}
                    <li>Aucun status.</li>
                {% endfor %}
            </ul>
            <h3>Metrics ({{ metrics.length }})</h3>
            <div>
                {% for metric in metrics %}
                    <h4><span>{{ metric.label }}</span> : <span>{{ metric.valueLabel }}</span></h4>
                    {% if metric.value %}
                        <div>
                            {{ metric.value | safe }}
                        </div>
                    {% endif %}
                {% else %}
                    <li>-</li>
                {% endfor %}
            </div>
        </div>
    {% endblock %}
</div>
</body>
</html>