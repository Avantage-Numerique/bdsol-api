{% extends 'default.njk' %}

{% block content %}

    <div class="container">

        {% block contentHeader %}
            {% include "Partials/header.njk" %}
        {% endblock %}

        <nav class="breadcrumbs default-padding-y">
            <ul>
                <li>
                    <a class="btn" href="/" title={{ api.name }}>
                        <i class="las la-home"></i>
                    </a>
                </li>
                <li>
                    <span>{{ title }}</span>
                </li>
            </ul>
        </nav>

        <h1>{{ title }}</h1>

        <h2>Ontologies supportées</h2>

        {% for ontologyKey, ontology in metaItems %}

            <p>
                <h3 id="{{ ontologyKey }}">
                    <a href="{{ ontology.referentialUrl }}" ">{{ ontology.label }}</a>
                </h3>
            </p>

            <p>{{ ontology.description }}</p>

            {% set ontology = items[ontologyKey] %}

            <table class="ref">

                <thead>
                    <tr>
                        <th>Entité AVNU</th>
                        <th>URL externe</th>
                        <th>Description</th>
                    </tr>
                </thead>

                <tbody>

                    {% for entityKey, entity in ontology %}

                        <tr>
                            <td>
                                <a href="{{ baseUrl }}{{ baseRoute }}/compatibility/{{ entityKey }}">
                                    {{ entityKey }}
                                </a>
                            </td>

                            <td>
                                {% if entity.external %}
                                    <a href="{{ entity.external }}">{{ entity["@type"] or entityKey }}</a>
                                {% else %}
                                    {{ entity["@type"] or entityKey }}
                                {% endif %}
                            </td>

                            <td>{{ entity.description }}</td>
                        </tr>

                    {% endfor %}

                </tbody>

            </table>
        {% endfor %}
    </div>
{% endblock %}

{% block contentFooter %}
    <section class="container"></section>
{% endblock %}