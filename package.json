{
    "name": "bdsolapi",
    "version": "1.0.5",
    "description": "La BDSOL disponible grâce à docker, avec toutes ses facettes. Principalement pour le developpement.",
    "main": "src/server.ts",
    "private": true,
    "scripts": {
        "testdb": "npx ts-node -r tsconfig-paths/register src/testDbConnection.ts",
        "build-views": "npx ts-node src/build-views.ts",
        "tsc": "tsc && tsc-alias && npm run build-views",
        "tsctest": "tsc --outDir \"../build-api\" && tsc-alias --outDir \"../build-api\"",
        "serve": "node build/src/server.js",
        "serve-ts": "npx ts-node src/server.ts",
        "backup-ts": "npx ts-node -r tsconfig-paths/register src/backup.ts",
        "preparesync-ts": "npx ts-node -r tsconfig-paths/register src/presync.ts",
        "sync-ts": "npx ts-node -r tsconfig-paths/register src/sync.ts",
        "restore-ts": "npx ts-node -r tsconfig-paths/register src/restore.ts",
        "dev": "npx nodemon -r tsconfig-paths/register src/server.ts",
        "start": "node ./build/src/server.js",
        "test": "echo \"Error: no test specified\" && exit 1",
        "lint": "eslint . --ext .ts",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint:check": "eslint .",
        "lint:fix": "eslint --fix .",
        "check": "prettier --check . && eslint .",
        "fix": "prettier --write . && eslint --fix ."
    },
    "keywords": [],
    "authors": [
        "Marc-André Martin",
        "Frédéric Rivard",
        "Jules Luzy-Riopel"
    ],
    "license": "à venir",
    "dependencies": {
        "@braintree/sanitize-url": "^7.1.2",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/http-server": "^0.12.4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/lodash.deburr": "^4.1.9",
        "@types/mime-db": "^1.43.6",
        "@types/mime-types": "^3.0.1",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.6",
        "@types/node-schedule": "^2.1.8",
        "@types/nodemailer": "^8.0.2",
        "@types/nunjucks": "^3.2.6",
        "@types/sanitize-html": "^2.16.2",
        "argon2": "^0.45.2",
        "cors": "^2.8.6",
        "dotenv": "^18.0.10",
        "express": "^4.22.3",
        "express-validator": "^7.3.2",
        "fix": "^0.0.3",
        "http-status-codes": "^2.3.0",
        "jsonwebtoken": "9.0.3",
        "line-awesome": "^2.1.0",
        "lodash.deburr": "^4.1.0",
        "mime-db": "^1.54.0",
        "mime-types": "^2.1.35",
        "mongodb": "^7.9.0",
        "mongoose": "^9.12.1",
        "mongoose-slug-updater": "^3.3.0",
        "multer": "^2.5.0",
        "node-schedule": "^2.1.2",
        "nodemailer": "^10.5.0",
        "nunjucks": "^3.2.4",
        "sanitize-html": "^2.18.2",
        "ts-migrate-mongoose": "^5.3.3",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.10",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3"
    },
    "devDependencies": {
        "@types/express-list-endpoints": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "eslint": "9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "express-list-endpoints": "^7.1.1",
        "nodemon": "^3.1.14",
        "prettier": "^3.10.1"
    },
    "volta": {
        "node": "22.23.4"
    }
}
